<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_A2"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_A2">
    <bpmn:participant id="Participant_A2" name="Sistema de Gestión de Horarios SENA" processRef="Process_A2" />
  </bpmn:collaboration>

  <bpmn:process id="Process_A2" name="A2 - Gestión de Notificaciones de Cambios" isExecutable="true">
    <bpmn:laneSet id="LaneSet_A2">
      <bpmn:lane id="Lane_Aprendiz_A2" name="Aprendiz">
        <bpmn:flowNodeRef>Task_VerListadoNotificaciones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SeguirDeepLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_A2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema_A2" name="Servicio de Notificaciones / Backend">
        <bpmn:flowNodeRef>Start_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarcarLeida</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_A2" name="Alerta Generada por el Sistema">
      <bpmn:outgoing>FA2_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_VerListadoNotificaciones" name="Revisar Badge y Abrir Centro de Notificaciones">
      <bpmn:incoming>FA2_1</bpmn:incoming>
      <bpmn:outgoing>FA2_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_MarcarLeida" name="Actualizar Estado a Leída (isRead = true)">
      <bpmn:incoming>FA2_2</bpmn:incoming>
      <bpmn:outgoing>FA2_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_SeguirDeepLink" name="Hacer Clic en DeepLink Directo a la Sesión / Horario">
      <bpmn:incoming>FA2_3</bpmn:incoming>
      <bpmn:outgoing>FA2_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_A2" name="Aprendiz Informado">
      <bpmn:incoming>FA2_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="FA2_1" sourceRef="Start_A2" targetRef="Task_VerListadoNotificaciones" />
    <bpmn:sequenceFlow id="FA2_2" sourceRef="Task_VerListadoNotificaciones" targetRef="Task_MarcarLeida" />
    <bpmn:sequenceFlow id="FA2_3" sourceRef="Task_MarcarLeida" targetRef="Task_SeguirDeepLink" />
    <bpmn:sequenceFlow id="FA2_4" sourceRef="Task_SeguirDeepLink" targetRef="End_A2" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_A2">
    <bpmndi:BPMNPlane id="BPMNPlane_A2" bpmnElement="Collaboration_A2">
      <bpmndi:BPMNShape id="Participant_A2_di" bpmnElement="Participant_A2" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="940" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Aprendiz_A2_di" bpmnElement="Lane_Aprendiz_A2" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="910" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistema_A2_di" bpmnElement="Lane_Sistema_A2" isHorizontal="true">
        <dc:Bounds x="160" y="250" width="910" height="190" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_A2_di" bpmnElement="Start_A2">
        <dc:Bounds x="212" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="195" y="365" width="70" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerListadoNotificaciones_di" bpmnElement="Task_VerListadoNotificaciones">
        <dc:Bounds x="300" y="110" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarcarLeida_di" bpmnElement="Task_MarcarLeida">
        <dc:Bounds x="500" y="300" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SeguirDeepLink_di" bpmnElement="Task_SeguirDeepLink">
        <dc:Bounds x="690" y="110" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_A2_di" bpmnElement="End_A2">
        <dc:Bounds x="902" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="890" y="175" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="FA2_1_di" bpmnElement="FA2_1">
        <di:waypoint x="248" y="340" />
        <di:waypoint x="270" y="340" />
        <di:waypoint x="270" y="150" />
        <di:waypoint x="300" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FA2_2_di" bpmnElement="FA2_2">
        <di:waypoint x="460" y="150" />
        <di:waypoint x="480" y="150" />
        <di:waypoint x="480" y="340" />
        <di:waypoint x="500" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FA2_3_di" bpmnElement="FA2_3">
        <di:waypoint x="650" y="340" />
        <di:waypoint x="670" y="340" />
        <di:waypoint x="670" y="150" />
        <di:waypoint x="690" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FA2_4_di" bpmnElement="FA2_4">
        <di:waypoint x="850" y="150" />
        <di:waypoint x="902" y="150" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
