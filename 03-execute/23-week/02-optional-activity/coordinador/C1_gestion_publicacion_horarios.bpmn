<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_C1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_C1">
    <bpmn:participant id="Participant_C1" name="Sistema de Gestión de Horarios SENA" processRef="Process_C1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_C1" name="C1 - Gestión y Publicación de Horarios" isExecutable="true">
    <bpmn:laneSet id="LaneSet_C1">
      <bpmn:lane id="Lane_Coordinador_C1" name="Coordinador Académico">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CrearBorrador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AsignarSesiones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolverConflicto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmarPublicacion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema_C1" name="Motor de Scheduling / Backend">
        <bpmn:flowNodeRef>Task_ValidarConflictos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Conflictos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BloquearYNotificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Inicio de Programación">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CrearBorrador" name="Crear Borrador de Horario (Ficha, Período, Nombre)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AsignarSesiones" name="Asignar Sesiones (Competencia, Franja, Aula, Docente)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_Reintentar</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidarConflictos" name="Validar Reglas de Conflicto en Tiempo Real">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Conflictos" name="¿Existen Conflictos?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_ConConflictos</bpmn:outgoing>
      <bpmn:outgoing>Flow_SinConflictos</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ResolverConflicto" name="Resolver Conflicto con Justificación Obligatoria">
      <bpmn:incoming>Flow_ConConflictos</bpmn:incoming>
      <bpmn:outgoing>Flow_Reintentar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ConfirmarPublicacion" name="Confirmar Publicación Oficial">
      <bpmn:incoming>Flow_SinConflictos</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_BloquearYNotificar" name="Bloquear Edición (PUBLISHED) y Despachar Notificaciones">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Horario Publicado Oficialmente">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CrearBorrador" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CrearBorrador" targetRef="Task_AsignarSesiones" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_AsignarSesiones" targetRef="Task_ValidarConflictos" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ValidarConflictos" targetRef="Gateway_Conflictos" />
    <bpmn:sequenceFlow id="Flow_ConConflictos" name="Sí (Bloqueante)" sourceRef="Gateway_Conflictos" targetRef="Task_ResolverConflicto" />
    <bpmn:sequenceFlow id="Flow_Reintentar" sourceRef="Task_ResolverConflicto" targetRef="Task_AsignarSesiones" />
    <bpmn:sequenceFlow id="Flow_SinConflictos" name="No" sourceRef="Gateway_Conflictos" targetRef="Task_ConfirmarPublicacion" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ConfirmarPublicacion" targetRef="Task_BloquearYNotificar" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_BloquearYNotificar" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_C1">
    <bpmndi:BPMNPlane id="BPMNPlane_C1" bpmnElement="Collaboration_C1">
      <bpmndi:BPMNShape id="Participant_C1_di" bpmnElement="Participant_C1" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="1280" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Coordinador_C1_di" bpmnElement="Lane_Coordinador_C1" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1250" height="210" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistema_C1_di" bpmnElement="Lane_Sistema_C1" isHorizontal="true">
        <dc:Bounds x="160" y="270" width="1250" height="210" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="212" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="195" y="185" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CrearBorrador_di" bpmnElement="Task_CrearBorrador">
        <dc:Bounds x="300" y="120" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AsignarSesiones_di" bpmnElement="Task_AsignarSesiones">
        <dc:Bounds x="480" y="120" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidarConflictos_di" bpmnElement="Task_ValidarConflictos">
        <dc:Bounds x="480" y="330" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Conflictos_di" bpmnElement="Gateway_Conflictos" isMarkerVisible="true">
        <dc:Bounds x="705" y="345" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="698" y="405" width="65" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ResolverConflicto_di" bpmnElement="Task_ResolverConflicto">
        <dc:Bounds x="660" y="120" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmarPublicacion_di" bpmnElement="Task_ConfirmarPublicacion">
        <dc:Bounds x="870" y="120" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BloquearYNotificar_di" bpmnElement="Task_BloquearYNotificar">
        <dc:Bounds x="1070" y="330" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1292" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1268" y="395" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="248" y="160" />
        <di:waypoint x="300" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="430" y="160" />
        <di:waypoint x="480" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="555" y="200" />
        <di:waypoint x="555" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="630" y="370" />
        <di:waypoint x="705" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ConConflictos_di" bpmnElement="Flow_ConConflictos">
        <di:waypoint x="730" y="345" />
        <di:waypoint x="730" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="735" y="250" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reintentar_di" bpmnElement="Flow_Reintentar">
        <di:waypoint x="660" y="160" />
        <di:waypoint x="630" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SinConflictos_di" bpmnElement="Flow_SinConflictos">
        <di:waypoint x="755" y="370" />
        <di:waypoint x="830" y="370" />
        <di:waypoint x="830" y="160" />
        <di:waypoint x="870" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="842" y="250" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1010" y="160" />
        <di:waypoint x="1040" y="160" />
        <di:waypoint x="1040" y="370" />
        <di:waypoint x="1070" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1230" y="370" />
        <di:waypoint x="1292" y="370" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>