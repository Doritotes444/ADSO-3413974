<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_I2"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_I2">
    <bpmn:participant id="Participant_I2" name="Sistema de Gestión de Horarios SENA" processRef="Process_I2" />
  </bpmn:collaboration>

  <bpmn:process id="Process_I2" name="I2 - Registro de Excepción de Disponibilidad" isExecutable="true">
    <bpmn:laneSet id="LaneSet_I2">
      <bpmn:lane id="Lane_Instructor_I2" name="Instructor">
        <bpmn:flowNodeRef>Start_I2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DiligenciarNovedad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Soporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjuntarSoporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviarSolicitud</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema_I2" name="Servicio de Disponibilidad / Backend">
        <bpmn:flowNodeRef>Task_GuardarPendiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_I2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_I2" name="Novedad en Disponibilidad">
      <bpmn:outgoing>FL_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_DiligenciarNovedad" name="Seleccionar Tipo de Excepción y Rango de Fechas">
      <bpmn:incoming>FL_1</bpmn:incoming>
      <bpmn:outgoing>FL_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Soporte" name="¿Exige Soporte Documental?">
      <bpmn:incoming>FL_2</bpmn:incoming>
      <bpmn:outgoing>FL_SiSoporte</bpmn:outgoing>
      <bpmn:outgoing>FL_NoSoporte</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AdjuntarSoporte" name="Adjuntar Soporte en PDF (EPS, Comisión, etc.)">
      <bpmn:incoming>FL_SiSoporte</bpmn:incoming>
      <bpmn:outgoing>FL_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EnviarSolicitud" name="Enviar Solicitud a Coordinación">
      <bpmn:incoming>FL_NoSoporte</bpmn:incoming>
      <bpmn:incoming>FL_3</bpmn:incoming>
      <bpmn:outgoing>FL_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_GuardarPendiente" name="Registrar Excepción en Estado PENDING y Alertar a Coordinación">
      <bpmn:incoming>FL_4</bpmn:incoming>
      <bpmn:outgoing>FL_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_I2" name="Solicitud Radicada">
      <bpmn:incoming>FL_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="FL_1" sourceRef="Start_I2" targetRef="Task_DiligenciarNovedad" />
    <bpmn:sequenceFlow id="FL_2" sourceRef="Task_DiligenciarNovedad" targetRef="Gateway_Soporte" />
    <bpmn:sequenceFlow id="FL_SiSoporte" name="Sí" sourceRef="Gateway_Soporte" targetRef="Task_AdjuntarSoporte" />
    <bpmn:sequenceFlow id="FL_3" sourceRef="Task_AdjuntarSoporte" targetRef="Task_EnviarSolicitud" />
    <bpmn:sequenceFlow id="FL_NoSoporte" name="No" sourceRef="Gateway_Soporte" targetRef="Task_EnviarSolicitud" />
    <bpmn:sequenceFlow id="FL_4" sourceRef="Task_EnviarSolicitud" targetRef="Task_GuardarPendiente" />
    <bpmn:sequenceFlow id="FL_5" sourceRef="Task_GuardarPendiente" targetRef="End_I2" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_I2">
    <bpmndi:BPMNPlane id="BPMNPlane_I2" bpmnElement="Collaboration_I2">
      <bpmndi:BPMNShape id="Participant_I2_di" bpmnElement="Participant_I2" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="1120" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Instructor_I2_di" bpmnElement="Lane_Instructor_I2" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1090" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistema_I2_di" bpmnElement="Lane_Sistema_I2" isHorizontal="true">
        <dc:Bounds x="160" y="250" width="1090" height="190" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_I2_di" bpmnElement="Start_I2">
        <dc:Bounds x="212" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="195" y="175" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DiligenciarNovedad_di" bpmnElement="Task_DiligenciarNovedad">
        <dc:Bounds x="300" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Soporte_di" bpmnElement="Gateway_Soporte" isMarkerVisible="true">
        <dc:Bounds x="485" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="473" y="95" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AdjuntarSoporte_di" bpmnElement="Task_AdjuntarSoporte">
        <dc:Bounds x="580" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnviarSolicitud_di" bpmnElement="Task_EnviarSolicitud">
        <dc:Bounds x="760" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GuardarPendiente_di" bpmnElement="Task_GuardarPendiente">
        <dc:Bounds x="940" y="300" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_I2_di" bpmnElement="End_I2">
        <dc:Bounds x="1152" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1145" y="365" width="51" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="FL_1_di" bpmnElement="FL_1">
        <di:waypoint x="248" y="150" />
        <di:waypoint x="300" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FL_2_di" bpmnElement="FL_2">
        <di:waypoint x="440" y="150" />
        <di:waypoint x="485" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FL_SiSoporte_di" bpmnElement="FL_SiSoporte">
        <di:waypoint x="535" y="150" />
        <di:waypoint x="580" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="552" y="132" width="12" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FL_3_di" bpmnElement="FL_3">
        <di:waypoint x="720" y="150" />
        <di:waypoint x="760" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FL_NoSoporte_di" bpmnElement="FL_NoSoporte">
        <di:waypoint x="510" y="175" />
        <di:waypoint x="510" y="220" />
        <di:waypoint x="830" y="220" />
        <di:waypoint x="830" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="518" y="193" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FL_4_di" bpmnElement="FL_4">
        <di:waypoint x="900" y="150" />
        <di:waypoint x="920" y="150" />
        <di:waypoint x="920" y="340" />
        <di:waypoint x="940" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FL_5_di" bpmnElement="FL_5">
        <di:waypoint x="1100" y="340" />
        <di:waypoint x="1152" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
