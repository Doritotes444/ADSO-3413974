<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_I3"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_I3">
    <bpmn:participant id="Participant_I3" name="Sistema de Gestión de Horarios SENA" processRef="Process_I3" />
  </bpmn:collaboration>

  <bpmn:process id="Process_I3" name="I3 - Registro de Seguimiento Académico a Ficha" isExecutable="true">
    <bpmn:laneSet id="LaneSet_I3">
      <bpmn:lane id="Lane_Instructor_I3" name="Instructor">
        <bpmn:flowNodeRef>Start_I3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SeleccionarFicha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DiligenciarSeguimiento</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema_I3" name="Motor de Monitoreo / Alertas">
        <bpmn:flowNodeRef>Task_ValidarYCalcular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuardarYEvaluarAlertas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_I3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_I3" name="Cierre de Franja Formativa">
      <bpmn:outgoing>F_SF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SeleccionarFicha" name="Seleccionar Ficha y Tipo de Sesión">
      <bpmn:incoming>F_SF1</bpmn:incoming>
      <bpmn:outgoing>F_SF2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_DiligenciarSeguimiento" name="Ingresar Asistentes, Total Aprendices, % Avance y Obs">
      <bpmn:incoming>F_SF2</bpmn:incoming>
      <bpmn:outgoing>F_SF3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidarYCalcular" name="Validar Regla (Asistentes &lt;= Total) y Calcular % Asistencia">
      <bpmn:incoming>F_SF3</bpmn:incoming>
      <bpmn:outgoing>F_SF4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GuardarYEvaluarAlertas" name="Guardar Registro y Evaluar Umbrales de Riesgo / Alertas">
      <bpmn:incoming>F_SF4</bpmn:incoming>
      <bpmn:outgoing>F_SF5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_I3" name="Seguimiento Registrado">
      <bpmn:incoming>F_SF5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F_SF1" sourceRef="Start_I3" targetRef="Task_SeleccionarFicha" />
    <bpmn:sequenceFlow id="F_SF2" sourceRef="Task_SeleccionarFicha" targetRef="Task_DiligenciarSeguimiento" />
    <bpmn:sequenceFlow id="F_SF3" sourceRef="Task_DiligenciarSeguimiento" targetRef="Task_ValidarYCalcular" />
    <bpmn:sequenceFlow id="F_SF4" sourceRef="Task_ValidarYCalcular" targetRef="Task_GuardarYEvaluarAlertas" />
    <bpmn:sequenceFlow id="F_SF5" sourceRef="Task_GuardarYEvaluarAlertas" targetRef="End_I3" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_I3">
    <bpmndi:BPMNPlane id="BPMNPlane_I3" bpmnElement="Collaboration_I3">
      <bpmndi:BPMNShape id="Participant_I3_di" bpmnElement="Participant_I3" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="1080" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Instructor_I3_di" bpmnElement="Lane_Instructor_I3" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1050" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistema_I3_di" bpmnElement="Lane_Sistema_I3" isHorizontal="true">
        <dc:Bounds x="160" y="250" width="1050" height="190" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_I3_di" bpmnElement="Start_I3">
        <dc:Bounds x="212" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="195" y="175" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SeleccionarFicha_di" bpmnElement="Task_SeleccionarFicha">
        <dc:Bounds x="300" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DiligenciarSeguimiento_di" bpmnElement="Task_DiligenciarSeguimiento">
        <dc:Bounds x="490" y="110" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidarYCalcular_di" bpmnElement="Task_ValidarYCalcular">
        <dc:Bounds x="490" y="300" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GuardarYEvaluarAlertas_di" bpmnElement="Task_GuardarYEvaluarAlertas">
        <dc:Bounds x="710" y="300" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_I3_di" bpmnElement="End_I3">
        <dc:Bounds x="932" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="920" y="365" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F_SF1_di" bpmnElement="F_SF1">
        <di:waypoint x="248" y="150" />
        <di:waypoint x="300" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_SF2_di" bpmnElement="F_SF2">
        <di:waypoint x="440" y="150" />
        <di:waypoint x="490" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_SF3_di" bpmnElement="F_SF3">
        <di:waypoint x="570" y="190" />
        <di:waypoint x="570" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_SF4_di" bpmnElement="F_SF4">
        <di:waypoint x="650" y="340" />
        <di:waypoint x="710" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_SF5_di" bpmnElement="F_SF5">
        <di:waypoint x="870" y="340" />
        <di:waypoint x="932" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
