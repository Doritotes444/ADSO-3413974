<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_D2"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_D2">
    <bpmn:participant id="Participant_D2" name="Sistema de Gestión de Horarios SENA" processRef="Process_D2" />
  </bpmn:collaboration>

  <bpmn:process id="Process_D2" name="D2 - Gestión de Cuentas de Usuario y Roles RBAC" isExecutable="true">
    <bpmn:laneSet id="LaneSet_D2">
      <bpmn:lane id="Lane_Director_D2" name="Director de Centro">
        <bpmn:flowNodeRef>Start_D2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarUsuario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AsignarRolScope</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema_D2" name="Servicio de Identidad (IAM) / Auditoría">
        <bpmn:flowNodeRef>Task_GuardarYAuditarUsuario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_D2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_D2" name="Gestión de Acceso">
      <bpmn:outgoing>FD2_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_RegistrarUsuario" name="Ingresar Correo Institucional, Nombres y Tipo de Actor">
      <bpmn:incoming>FD2_1</bpmn:incoming>
      <bpmn:outgoing>FD2_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AsignarRolScope" name="Asignar Rol, Centro de Formación y Motivo Auditado">
      <bpmn:incoming>FD2_2</bpmn:incoming>
      <bpmn:outgoing>FD2_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_GuardarYAuditarUsuario" name="Guardar Usuario y Registrar Evento en Auditoría (USER_ROLE_ASSIGNED)">
      <bpmn:incoming>FD2_3</bpmn:incoming>
      <bpmn:outgoing>FD2_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_D2" name="Usuario y Permisos Configurados">
      <bpmn:incoming>FD2_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="FD2_1" sourceRef="Start_D2" targetRef="Task_RegistrarUsuario" />
    <bpmn:sequenceFlow id="FD2_2" sourceRef="Task_RegistrarUsuario" targetRef="Task_AsignarRolScope" />
    <bpmn:sequenceFlow id="FD2_3" sourceRef="Task_AsignarRolScope" targetRef="Task_GuardarYAuditarUsuario" />
    <bpmn:sequenceFlow id="FD2_4" sourceRef="Task_GuardarYAuditarUsuario" targetRef="End_D2" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_D2">
    <bpmndi:BPMNPlane id="BPMNPlane_D2" bpmnElement="Collaboration_D2">
      <bpmndi:BPMNShape id="Participant_D2_di" bpmnElement="Participant_D2" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="940" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Director_D2_di" bpmnElement="Lane_Director_D2" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="910" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistema_D2_di" bpmnElement="Lane_Sistema_D2" isHorizontal="true">
        <dc:Bounds x="160" y="250" width="910" height="190" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_D2_di" bpmnElement="Start_D2">
        <dc:Bounds x="212" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="195" y="175" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegistrarUsuario_di" bpmnElement="Task_RegistrarUsuario">
        <dc:Bounds x="300" y="110" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AsignarRolScope_di" bpmnElement="Task_AsignarRolScope">
        <dc:Bounds x="510" y="110" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GuardarYAuditarUsuario_di" bpmnElement="Task_GuardarYAuditarUsuario">
        <dc:Bounds x="700" y="300" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_D2_di" bpmnElement="End_D2">
        <dc:Bounds x="922" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="910" y="365" width="60" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="FD2_1_di" bpmnElement="FD2_1">
        <di:waypoint x="248" y="150" />
        <di:waypoint x="300" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FD2_2_di" bpmnElement="FD2_2">
        <di:waypoint x="460" y="150" />
        <di:waypoint x="510" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FD2_3_di" bpmnElement="FD2_3">
        <di:waypoint x="670" y="150" />
        <di:waypoint x="685" y="150" />
        <di:waypoint x="685" y="340" />
        <di:waypoint x="700" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FD2_4_di" bpmnElement="FD2_4">
        <di:waypoint x="870" y="340" />
        <di:waypoint x="922" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
